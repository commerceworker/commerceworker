{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/.wrangler",
      "!**/.react-router",
      "!**/.astro",
      "!**/build",
      "!**/dist",
      "!**/node_modules",
      "!**/worker-configuration.d.ts",
      "!packages/db/migrations/meta",
      "!packages/core/tests/fixtures/ucp",
      "!packages/docs-index/src/generated.ts",
      "!packages/http/src/mcp/skills.generated.ts",
      "!packages/sdk/commerce/src/generated/operations.ts",
      "!packages/sdk/catalog/src/generated/limits.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": { "noUnusedImports": "off", "noUnusedVariables": "off" }
        }
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": { "rules": { "suspicious": { "noUndeclaredEnvVars": "off" } } }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
