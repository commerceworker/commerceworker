{
  "name": "@commerceworker/adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare implementations of the ports: Workers AI, Vectorize, R2, KV cache and asset gate, the catalog's read edge, Queues, the native rate limiter, Images, Stream, Email, Worker Loader plugins, HTTP effects (webhooks/functions), structured import parsers, the space export reader. One subpath per adapter so each Worker bundles only what it binds.",
  "exports": {
    "./ai-workers": "./src/ai-workers/index.ts",
    "./asset-gate-kv": "./src/asset-gate-kv/index.ts",
    "./blob-r2": "./src/blob-r2/index.ts",
    "./cache-kv": "./src/cache-kv/index.ts",
    "./catalog-edge": "./src/catalog-edge/index.ts",
    "./email-cf": "./src/email-cf/index.ts",
    "./http-effects": "./src/http-effects/index.ts",
    "./images-cf": "./src/images-cf/index.ts",
    "./import-space-export": "./src/import-space-export/index.ts",
    "./import-structured": "./src/import-structured/index.ts",
    "./plugins-cf-loader": "./src/plugins-cf-loader/index.ts",
    "./queue-cf": "./src/queue-cf/index.ts",
    "./rate-limit-cf": "./src/rate-limit-cf/index.ts",
    "./vector-kv-dev": "./src/vector-kv-dev/index.ts",
    "./vector-vectorize": "./src/vector-vectorize/index.ts",
    "./video-stream": "./src/video-stream/index.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@commerceworker/domain": "workspace:*",
    "@commerceworker/ports": "workspace:*",
    "fast-png": "catalog:",
    "thumbhash": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@commerceworker/test-kit": "workspace:*",
    "@commerceworker/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0"
}
