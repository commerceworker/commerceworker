{
  "name": "@commerceworker/cli",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "The commerceworker CLI: sign in to a deployment, keep the content model in code, read and write entries, upload assets, import files and generate types. JSON output for agents.",
  "bin": {
    "commerceworker": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup src/bin.ts --format esm",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@commerceworker/sdk-codegen": "workspace:*",
    "@commerceworker/sdk-core": "workspace:*",
    "@commerceworker/sdk-management": "workspace:*",
    "@commerceworker/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
