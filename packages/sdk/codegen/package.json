{
  "name": "@commerceworker/sdk-codegen",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://docs.commerceworker.com/content/guides/sdks/",
  "repository": {
    "type": "git",
    "url": "https://github.com/commerceworker/commerceworker",
    "directory": "packages/sdk/codegen"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "commerceworker-codegen": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm && tsc -p tsconfig.json --noEmit false --declaration --emitDeclarationOnly --outDir dist --rootDir src",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@commerceworker/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
