{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // The embed's source is the repo's docs/content/, outside this package: without it an edited
    // page would hit the cache and leave the embed stale.
    "generate": {
      "inputs": ["scripts/generate.ts", "$TURBO_ROOT$/docs/content/*.md"],
      "outputs": ["src/generated.ts"]
    }
  }
}
