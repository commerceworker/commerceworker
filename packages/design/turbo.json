{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // tests/tokens.test.ts holds the tokens to both admins' and the storefront's app.css, the
    // studio's status component, the UI components and the docs site's styles, none of them in
    // this package. The themes it generates are gitignored, so they stay out of the hash.
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/app/app.css",
        "$TURBO_ROOT$/apps/studio/app/app.css",
        "$TURBO_ROOT$/apps/storefront/app/app.css",
        "$TURBO_ROOT$/apps/studio/app/components/status.tsx",
        "$TURBO_ROOT$/apps/docs/src/**",
        "$TURBO_ROOT$/packages/ui/src/**"
      ]
    }
  }
}
