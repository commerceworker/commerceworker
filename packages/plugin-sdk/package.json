{
  "name": "@commerceworker/plugin-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "What a plugin is built with: definePlugin (the PluginRpc entrypoint with principal, role and manifest checks), the contract suite every plugin's tests run, and a bundler that runs a plugin as a test Worker. See docs/plugins.md.",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "biome check .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@commerceworker/core": "workspace:*",
    "esbuild": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@commerceworker/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
