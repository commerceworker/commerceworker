---
/*
 * The skills an A2A agent can ask for, rendered from A2A_SKILLS in @commerceworker/core: the table the
 * Agent Card is built from, so a new tool or a changed role shows up here on rebuild.
 */
import { A2A_SKILLS, type A2ASkill, ROLE_LABELS } from '@commerceworker/core';

const skills = (Object.keys(A2A_SKILLS) as A2ASkill[]).map((id) => ({ id, ...A2A_SKILLS[id] }));
---

<table>
  <thead>
    <tr>
      <th>Skill</th>
      <th>Role</th>
      <th>Access</th>
      <th>Does</th>
    </tr>
  </thead>
  <tbody>
    {
      skills.map((s) => (
        <tr>
          <td>
            <code>{s.id}</code>
          </td>
          <td>
            <code>{s.role}</code> ({ROLE_LABELS[s.role]})
          </td>
          <td>{s.tags.includes('write') ? 'Write' : 'Read'}</td>
          <td>{s.description}</td>
        </tr>
      ))
    }
  </tbody>
</table>
