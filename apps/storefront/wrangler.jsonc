{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "commerceworker-storefront",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Every request is logged and traced (sampling 1 = all of them); lower the rate once traffic
  // makes the volume or cost matter.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "issues": { "enabled": true },
    "traces": { "enabled": true }
  },
  // A runaway request stops at 5 s of CPU (the default is 30 s). A cart page renders in well under
  // a second.
  "limits": { "cpu_ms": 5000 },
  // Runs near the engine rather than near the buyer: every request calls it.
  "placement": { "mode": "smart" },
  "upload_source_maps": true,
  // Trace events also go to Workers Logpush, like the web Worker's (docs/operations.md, "Logs").
  "logpush": true,
  // Served only at shop.commerceworker.com, so the zone's rules apply to every request: no workers.dev or
  // preview URL as a second way in.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "shop.commerceworker.com", "custom_domain": true }],
  // No database and no documents bucket: this Worker is public, so everything it needs from either
  // (a platform's key, a cart's files, a customer's name) is asked of the engine, and only through
  // the narrow StorefrontApi entrypoint (StorefrontRpc in @commerceworker/core), never EngineApi.
  "services": [
    { "binding": "ENGINE", "service": "commerceworker-engine", "entrypoint": "StorefrontApi" }
  ],
  // Per caller (app/lib/rate-limit.ts): a cart's buyer on product search, each UCP platform, and
  // each UCP platform's catalog search and lookup (its own budget: a search is cheap to ask for and
  // reads many documents, and must not use up what the platform's checkouts need). The registry's
  // `limits` changes them per deployment, as it does the web Worker's.
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "1006", "simple": { "limit": 600, "period": 60 } },
    { "name": "AGENT_LIMIT", "namespace_id": "1007", "simple": { "limit": 300, "period": 60 } },
    // Promo-code changes on a hosted checkout, per cookie, on top of API_LIMIT: guessing codes is the one
    // thing a buyer can do here that is worth a budget of its own.
    { "name": "PROMO_LIMIT", "namespace_id": "1008", "simple": { "limit": 20, "period": 60 } },
    { "name": "CATALOG_LIMIT", "namespace_id": "1009", "simple": { "limit": 120, "period": 60 } }
  ]
  // Secrets (set by the deploy, `scripts/fleet.ts secrets storefront`): STOREFRONT_KEY — signs what
  // this Worker forwards to the engine (a cart's buyer, a UCP platform) and the cookie a start link
  // sets. It is derived from PRINCIPAL_KEY (`storefrontKey` in @commerceworker/core), which this
  // Worker never holds: the engine checks these envelopes under the derived key alone, so a
  // compromised storefront can't sign as staff. STOREFRONT_KEY_PREVIOUS: the key before it,
  // while a rotation finishes.
}
