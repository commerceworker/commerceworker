{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // vite.config.ts reads the engine's and catalog's wrangler.jsonc for its dev-only auxiliary
    // Workers.
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/apps/engine/wrangler.jsonc",
        "$TURBO_ROOT$/apps/catalog/wrangler.jsonc"
      ]
    }
  }
}
