{
  "name": "@commerceworker/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The engine Worker: queue consumers, the cron sweeper, and every Durable Object and Workflow. No public route.",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "catalog:",
    "@commerceworker/adapters": "workspace:*",
    "@commerceworker/agent-runtime": "workspace:*",
    "@commerceworker/application": "workspace:*",
    "@commerceworker/store": "workspace:*",
    "@commerceworker/domain": "workspace:*",
    "@commerceworker/http": "workspace:*",
    "@commerceworker/platform": "workspace:*",
    "@commerceworker/ports": "workspace:*",
    "@commerceworker/redaction": "workspace:*",
    "@commerceworker/security": "workspace:*",
    "@commerceworker/seed": "workspace:*",
    "@commerceworker/test-kit": "workspace:*",
    "agents": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@commerceworker/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "license": "Apache-2.0"
}
