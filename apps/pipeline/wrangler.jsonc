{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The template for every deployment: scripts/fleet.ts renders wrangler.<id>.json from this file
  // and the deployment's registry entry <id>.jsonc (names, ids, routes, vars). Never deploy this file by hand.
  //
  // The engine: queue consumers, the cron sweeper, and the owner of every Durable Object and
  // Workflow class. No route, no workers.dev: the api and delivery Workers reach its objects and
  // workflows through bindings that name this script.
  "name": "commerceworker-pipeline",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat: node:crypto (token hashing, webhook HMAC). global_fetch_strictly_public: a
  // webhook, function or plugin fetch can never reach a private address (SSRF backstop under the
  // application's own url-safety checks).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  // Minified for a smaller script and a faster cold start; the uploaded source maps keep stack
  // traces readable.
  "minify": true,
  "upload_source_maps": true,
  // Several D1 round-trips per request: run near the D1 primary.
  "placement": {
    "mode": "smart"
  },
  "limits": {
    "cpu_ms": 30000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "analytics_engine_datasets": [
    {
      "binding": "METRICS",
      "dataset": "commerceworker_metrics"
    }
  ],
  // ---- Data -----------------------------------------------------------------------------------
  // D1 is the system of record. Requests open a read-replica session (wire.ts); turn on read
  // replication per database (scripts/provision.sh does).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "commerceworker-content",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/store/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV_CACHE"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "commerceworker-media"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "commerceworker-vectors"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Ingest reads image dimensions with `info` (not billed).
  "images": {
    "binding": "IMAGES"
  },
  "stream": {
    "binding": "STREAM"
  },
  "worker_loaders": [
    {
      "binding": "PLUGIN_LOADER"
    }
  ],
  // ---- Async ----------------------------------------------------------------------------------
  "queues": {
    "producers": [
      {
        "binding": "EVENTS_QUEUE",
        "queue": "commerceworker-events"
      },
      {
        "binding": "BULK_QUEUE",
        "queue": "commerceworker-bulk"
      },
      {
        "binding": "AGENTS_QUEUE",
        "queue": "commerceworker-agents"
      },
      {
        "binding": "PURGE_QUEUE",
        "queue": "commerceworker-purge"
      },
      // The media Worker's cache: a revoked asset's tag, now and once more after KV's read cache.
      {
        "binding": "MEDIA_PURGE_QUEUE",
        "queue": "commerceworker-media-purge"
      },
      // Re-ingest requests from asset_reindex bulk chunks.
      {
        "binding": "ASSET_EVENTS_QUEUE",
        "queue": "commerceworker-asset-events"
      }
    ],
    "consumers": [
      {
        "queue": "commerceworker-events",
        "max_batch_size": 25,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "max_concurrency": 10,
        "dead_letter_queue": "commerceworker-events-dlq"
      },
      {
        "queue": "commerceworker-bulk",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "retry_delay": 30,
        "max_concurrency": 10,
        "dead_letter_queue": "commerceworker-events-dlq"
      },
      {
        "queue": "commerceworker-agents",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 4,
        "dead_letter_queue": "commerceworker-events-dlq"
      },
      {
        "queue": "commerceworker-events-dlq",
        "max_batch_size": 25,
        "max_batch_timeout": 5
      },
      // R2 object-create notifications for the media bucket (scripts/provision.sh creates the
      // rule), plus the api's upload and re-ingest messages: each starts an AssetIngestWorkflow.
      {
        "queue": "commerceworker-asset-events",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "max_concurrency": 4,
        "dead_letter_queue": "commerceworker-asset-events-dlq"
      },
      {
        "queue": "commerceworker-asset-events-dlq",
        "max_batch_size": 25,
        "max_batch_timeout": 5
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_HUB",
        "class_name": "LiveHubDO"
      },
      {
        "name": "AI_BUDGET",
        "class_name": "CostGuardDO"
      },
      {
        "name": "SEARCH",
        "class_name": "SearchShardDO"
      },
      // The admin's assistant, one object per person (the api forwards its socket here).
      {
        "name": "ASSISTANT_AGENT",
        "class_name": "AssistantAgent"
      }
    ]
  },
  // Applied DO migration tags are frozen (scripts/do-migrations.test.ts): add, never edit.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LiveHubDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RateLimiterDO"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["CostGuardDO"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["SearchShardDO"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["AssistantAgent"]
    }
  ],
  "workflows": [
    {
      "binding": "AGENT_WF",
      "name": "commerceworker-agent",
      "class_name": "AgentWorkflow"
    },
    {
      "binding": "EDITORIAL_WF",
      "name": "commerceworker-editorial",
      "class_name": "EditorialWorkflow"
    },
    // One run per asset file version (hash, probe, enrich, extract, index), started by the
    // commerceworker-asset-events consumer.
    {
      "binding": "ASSET_INGEST_WF",
      "name": "commerceworker-asset-ingest",
      "class_name": "AssetIngestWorkflow"
    },
    // One run per zip download, started from `asset_zip.requested`: plan, then one step per 8 MiB
    // part of the archive (at most 2,560 for the 20 GiB cap, under the 10,000-step default).
    {
      "binding": "ASSET_ZIP_WF",
      "name": "commerceworker-asset-zip",
      "class_name": "AssetZipWorkflow"
    }
  ],
  // `send_email` (EMAIL) is added per deployment by scripts/fleet.ts when the deployment sets an
  // Email Sending sender (EMAIL_FROM); a bound EMAIL without a sender is refused at boot.
  // ---- Vars (secrets: DATA_KEY, TOKEN_PEPPER, SETUP_TOKEN, ADMIN_TOKEN, MCP_TOKEN,
  // MEDIA_SIGNING_SECRET, STREAM_WEBHOOK_SECRET, and ASSISTANT_PRINCIPAL_KEY(_PREVIOUS), derived
  // from PRINCIPAL_KEY by CI, with which the assistant checks its socket's signed principal) ----
  "vars": {
    // Rendered per deployment (scripts/fleet.ts): queue consumers route by the suffixed queue name.
    "QUEUE_SUFFIX": "",
    "ROLE": "all",
    "REQUIRE_SECURE_SECRETS": "true",
    "SEED_DEV": "false",
    "SEED_SCALE": "1",
    "AGENT_RUNTIME": "cloudflare-workflows",
    "AGENTS_ENRICH": "false",
    "AGENTS_MODERATE": "false",
    "AGENTS_AUTO_APPLY": "false",
    "AGENTS_SCHEDULES": "false",
    "VERSION_ARCHIVE": "false",
    "PLUGIN_MIN_RELEASE_AGE_HOURS": "",
    "PLUGIN_SOURCE_HOSTS": "",
    "AI_PROVIDER": "workers-ai",
    "AI_MODE": "live",
    "AI_TIMEOUT_MS": "20000",
    "AI_GATEWAY_ID": "commerceworker",
    "WORKERS_AI_MODEL_FLAGSHIP": "",
    "WORKERS_AI_MODEL_BALANCED": "",
    "WORKERS_AI_MODEL_FAST": "",
    "EMBEDDINGS_PROVIDER": "workers-ai",
    "EMBEDDINGS_DIM": "768",
    "EMBEDDINGS_MODEL": "",
    "ALLOW_FAKE_ADAPTERS": "",
    "MEDIA_BASE_URL": "",
    // The media Worker's origin (https://media.<domain>), rendered per deployment. Empty: delivered
    // assets keep the api's signed URLs, without renditions or a srcset.
    "MEDIA_PUBLIC_URL": "",
    "IMAGES_ZONE_ORIGIN": "",
    "AI_MAX_REQUESTS_PER_WINDOW": "60",
    "AI_MAX_TOKENS_PER_WINDOW": "200000",
    "AI_BUDGET_WINDOW_SECONDS": "60",
    "DELIVERY_CACHE_TTL_SECONDS": "86400",
    "DELIVERY_LIST_TTL_SECONDS": "3600",
    "EVENT_RETENTION_HOURS": "168",
    "EMAIL_FROM": "",
    "EMAIL_FROM_NAME": ""
  }
}
