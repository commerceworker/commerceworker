{
  "name": "@commerceworker/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard, flow editor, live order view, approvals and REST API: React Router on Workers.",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "deploy": "pnpm build && wrangler deploy",
    "types": "wrangler types && react-router typegen",
    "db:migrate:local": "wrangler d1 migrations apply commerceworker --local",
    "db:seed:local": "wrangler d1 execute commerceworker --local --file ../../packages/db/seed/0001_demo.sql",
    "db:seed:volume": "tsx scripts/seed-volume.ts",
    "db:seed:catalog": "tsx scripts/seed-catalog.ts",
    "db:seed:records": "tsx scripts/seed-records.ts",
    "db:seed:live": "tsx scripts/seed-live.ts",
    "db:seed:all": "tsx scripts/seed-all.ts",
    "db:migrate:remote": "wrangler d1 migrations apply commerceworker --remote",
    "test": "vitest run",
    "lint": "biome check .",
    "check-types": "react-router typegen && tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@cloudflare/ai-chat": "catalog:",
    "@cloudflare/workers-oauth-provider": "catalog:",
    "@commerceworker/core": "workspace:*",
    "@commerceworker/db": "workspace:*",
    "@commerceworker/ports": "workspace:*",
    "@commerceworker/ui": "workspace:*",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource/ibm-plex-mono": "catalog:",
    "@simplewebauthn/browser": "catalog:",
    "@simplewebauthn/server": "catalog:",
    "@xyflow/react": "catalog:",
    "agents": "catalog:",
    "ai": "catalog:",
    "drizzle-orm": "catalog:",
    "isbot": "catalog:",
    "jose": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@shadcn/react": "catalog:",
    "react-router": "catalog:",
    "recharts": "catalog:",
    "shiki": "catalog:",
    "streamdown": "catalog:",
    "uqr": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@commerceworker/test-kit": "workspace:*",
    "@babel/plugin-proposal-decorators": "catalog:",
    "@cloudflare/vite-plugin": "catalog:",
    "@commerceworker/typescript-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@react-router/dev": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
