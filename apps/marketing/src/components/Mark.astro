---
/** The CommerceWorker mark: an open loop with an arrowhead (an order coming back around). */
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M20 12a8 8 0 1 1-3.1-6.3"></path>
  <path d="M17.5 2.5v4h-4"></path>
  <rect x="9" y="9" width="6" height="6" rx="1" fill="currentColor" stroke="none"></rect>
</svg>
