{
  "name": "@commerceworker/delivery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The delivery Worker: the public Content Delivery API and the public read-only catalog API, each behind its own Workers Caching entrypoint, with authentication on every content request and rationed tag purges.",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "dev:catalog": "wrangler dev --port 8790 --config wrangler.catalog.jsonc",
    "deploy:catalog": "wrangler deploy --config wrangler.catalog.jsonc",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@commerceworker/application": "workspace:*",
    "@commerceworker/core": "workspace:*",
    "@commerceworker/domain": "workspace:*",
    "@commerceworker/http": "workspace:*",
    "@commerceworker/platform": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@commerceworker/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "license": "Apache-2.0"
}
