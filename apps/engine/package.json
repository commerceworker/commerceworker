    "@commerceworker/adapters": "workspace:*",
    "@commerceworker/application": "workspace:*",
    "@commerceworker/core": "workspace:*",
    "@commerceworker/db": "workspace:*",
    "@commerceworker/ports": "workspace:*",
    "@modelcontextprotocol/server": "catalog:",
    "agents": "catalog:",
    "ai": "catalog:",
    "drizzle-orm": "catalog:",
    "postal-mime": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "catalog:",
    "@cfworker/json-schema": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@commerceworker/plugin-sdk": "workspace:*",
    "@commerceworker/typescript-config": "workspace:*",
