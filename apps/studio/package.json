{
  "name": "@commerceworker/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Legacy content gateway and standalone local admin; deployed human pages redirect to the unified Web admin.",
  "scripts": {
    "dev": "node scripts/vendor-scalar.mjs && react-router dev",
    "build": "node scripts/vendor-scalar.mjs && react-router build",
    "deploy": "pnpm build && wrangler deploy",
    "types": "wrangler types && react-router typegen",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "lint": "biome check .",
    "check-types": "react-router typegen && tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@cloudflare/ai-chat": "catalog:",
    "@commerceworker/adapters": "workspace:*",
    "@commerceworker/store": "workspace:*",
    "@commerceworker/domain": "workspace:*",
    "@commerceworker/security": "workspace:*",
    "@commerceworker/ui": "workspace:*",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource/ibm-plex-mono": "catalog:",
    "@simplewebauthn/browser": "catalog:",
    "@simplewebauthn/server": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@xyflow/react": "catalog:",
    "agents": "catalog:",
    "ai": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "isbot": "catalog:",
    "jose": "catalog:",
    "lucide-react": "catalog:",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "recharts": "catalog:",
    "streamdown": "catalog:",
    "uqr": "catalog:",
    "use-stick-to-bottom": "catalog:",
    "@commerceworker/ports": "workspace:*",
    "@commerceworker/content-admin": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@commerceworker/typescript-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@react-router/dev": "catalog:",
    "@scalar/api-reference": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "@commerceworker/test-kit": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "license": "Apache-2.0"
}
